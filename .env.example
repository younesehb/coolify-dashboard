# Coolify API base URL. When Launchpad runs on the same server as Coolify, http://coolify:8080 skips any proxy or Cloudflare Access.
COOLIFY_URL=https://coolify.example.com
# Coolify → Keys & Tokens → API tokens. "read" is enough to browse; "deploy" is needed for actions.
COOLIFY_TOKEN=
# Optional: where the "Manage in Coolify" links should point (defaults to COOLIFY_URL).
COOLIFY_PUBLIC_URL=
# Optional: turns on Redeploy / Restart / Stop / Start. Leave empty to keep Launchpad read-only.
ACTIONS_PASSWORD=
# Optional: personalises the greeting.
OWNER_NAME=
# Optional: set to true to run with sample data and no Coolify at all.
DEMO=false
PORT=3000
